// Copy to IdentificationSecrets.xcconfig (ignored, required for Debug builds).
// This template is versioned; the real file must never be committed or shared.
API_SCHEME = https
// Replace the reserved .invalid example with your HTTPS API base (not /chat/completions).
API_HOST_PATH = api.example.invalid/v1
API_MODEL = vision-model
API_KEY =
// API_KEY is optional: blank omits Authorization; a service may still require it.
API_TIMEOUT_SECONDS = 60
// Never paste a key into chat, a scheme, shell arguments or build logs.
// xcconfig expands $(...) and treats // as a comment even inside quotes.
// If a credential needs special syntax, verify exact roundtrip against the original
// with scripts/verify-identification-config.py before sending any request.
