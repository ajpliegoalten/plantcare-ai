{
  "sourceLanguage" : "es",
  "strings" : {
    "externalAIConsent.title" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Antes de usar IA externa" } } } },
    "externalAIConsent.body" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Para identificar plantas y ofrecer orientación, las funciones de IA enviarán al proveedor externo configurado para esta demo la foto que elijas para IA o el texto necesario de tu planta (especie, cuidados, historial pertinente y tu pregunta, según la función). No se envía toda tu colección ni fotos antiguas para analizar una foto actual. Puedes cancelar antes de continuar. Recordaremos tu aceptación en este dispositivo para futuras solicitudes de IA que tú inicies." } } } },
    "externalAIConsent.notAvailable" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La identificación todavía no está disponible; aceptar este aviso no enviará tu foto ahora." } } } },
    "externalAIConsent.accept" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Aceptar y continuar" } } } },
    "externalAIConsent.unavailable" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La identificación todavía no está disponible. No se ha enviado ninguna foto." } } } },
    "externalAIConsent.error" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo comprobar o guardar tu aceptación. No se ha enviado ninguna foto. Pulsa Identificar para reintentar." } } } },
    "externalAIConsent.checking" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando autorización…" } } } },
