<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchAtmosphere" translatesAutoresizingMaskIntoConstraints="NO" id="atmosphere"/>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="hero">
                                <rect key="frame" x="61.5" y="292" width="270" height="300"/>
                                <subviews>
                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchBrand" translatesAutoresizingMaskIntoConstraints="NO" id="brand"/>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="wordmark">
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="PlantCare" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="32"/>
                                                <color key="textColor" name="Primary"/>
                                            </label>
                                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchAICapsule" translatesAutoresizingMaskIntoConstraints="NO" id="capsule"/>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="AI" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="ai">
                                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="13"/>
                                                <color key="textColor" red="0.0" green="0.1294117647" blue="0.0823529412" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </label>
                                        </subviews>
                                        <constraints>
                                            <constraint firstItem="title" firstAttribute="leading" secondItem="wordmark" secondAttribute="leading" id="title-leading"/>
                                            <constraint firstItem="title" firstAttribute="top" secondItem="wordmark" secondAttribute="top" id="title-top"/>
                                            <constraint firstAttribute="bottom" secondItem="title" secondAttribute="bottom" id="title-bottom"/>
                                            <constraint firstItem="capsule" firstAttribute="leading" secondItem="title" secondAttribute="trailing" constant="8" id="capsule-leading"/>
                                            <constraint firstItem="capsule" firstAttribute="centerY" secondItem="title" secondAttribute="centerY" id="capsule-center"/>
                                            <constraint firstAttribute="trailing" secondItem="capsule" secondAttribute="trailing" id="capsule-trailing"/>
                                            <constraint firstItem="capsule" firstAttribute="width" constant="34" id="capsule-width"/>
                                            <constraint firstItem="capsule" firstAttribute="height" constant="22" id="capsule-height"/>
                                            <constraint firstItem="ai" firstAttribute="centerX" secondItem="capsule" secondAttribute="centerX" id="ai-x"/>
                                            <constraint firstItem="ai" firstAttribute="centerY" secondItem="capsule" secondAttribute="centerY" id="ai-y"/>
                                        </constraints>
                                    </view>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Inteligencia botánica en tu bolsillo para un cuidado consciente." textAlignment="center" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="subtitle">
                                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                        <color key="textColor" name="TextSecondary"/>
                                    </label>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="brand" firstAttribute="top" secondItem="hero" secondAttribute="top" id="brand-top"/>
                                    <constraint firstItem="brand" firstAttribute="centerX" secondItem="hero" secondAttribute="centerX" id="brand-x"/>
                                    <constraint firstItem="brand" firstAttribute="width" constant="240" id="brand-width"/>
                                    <constraint firstItem="brand" firstAttribute="height" constant="240" id="brand-height"/>
                                    <constraint firstItem="wordmark" firstAttribute="top" secondItem="brand" secondAttribute="bottom" constant="-16" id="wordmark-top"/>
                                    <constraint firstItem="wordmark" firstAttribute="centerX" secondItem="hero" secondAttribute="centerX" id="wordmark-x"/>
                                    <constraint firstItem="subtitle" firstAttribute="top" secondItem="wordmark" secondAttribute="bottom" constant="8" id="subtitle-top"/>
                                    <constraint firstItem="subtitle" firstAttribute="leading" secondItem="hero" secondAttribute="leading" id="subtitle-leading"/>
                                    <constraint firstAttribute="trailing" secondItem="subtitle" secondAttribute="trailing" id="subtitle-trailing"/>
                                    <constraint firstAttribute="bottom" secondItem="subtitle" secondAttribute="bottom" id="subtitle-bottom"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-area"/>
                        <color key="backgroundColor" name="Background"/>
                        <constraints>
                            <constraint firstItem="atmosphere" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="atmosphere-leading"/>
                            <constraint firstAttribute="trailing" secondItem="atmosphere" secondAttribute="trailing" id="atmosphere-trailing"/>
                            <constraint firstItem="atmosphere" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="atmosphere-top"/>
                            <constraint firstAttribute="bottom" secondItem="atmosphere" secondAttribute="bottom" id="atmosphere-bottom"/>
                            <constraint firstItem="hero" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" id="hero-x"/>
                            <constraint firstItem="hero" firstAttribute="centerY" secondItem="safe-area" secondAttribute="centerY" id="hero-y"/>
                            <constraint firstItem="hero" firstAttribute="width" constant="270" id="hero-width"/>
                            <constraint firstItem="hero" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="safe-area" secondAttribute="leading" constant="20" id="hero-margin"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchAtmosphere" width="512" height="1024"/>
        <image name="LaunchBrand" width="240" height="240"/>
        <image name="LaunchAICapsule" width="34" height="22"/>
        <namedColor name="Background"><color red="0.9725490196" green="0.9803921569" blue="0.9490196078" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></namedColor>
        <namedColor name="Primary"><color red="0.1490196078" green="0.3019607843" blue="0.2352941176" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></namedColor>
        <namedColor name="TextSecondary"><color red="0.2549019608" green="0.2823529412" blue="0.2666666667" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></namedColor>
    </resources>
</document>
